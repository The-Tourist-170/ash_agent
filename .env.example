ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_COLORS=auto

DATABASE_URL=postgresql+asyncpg://ash:ash@localhost:5432/ash_agent
VALKEY_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=ash_agent:jobs
RUN_JOB_TIMEOUT_SECONDS=3600

GITHUB_WEBHOOK_SECRET=change-me-to-a-random-string
MAX_ATTEMPTS=3
MOCK_REPAIR_SUCCESS_ATTEMPT=1
JOB_MAX_RETRIES=2
GRAPH_RECURSION_LIMIT=50

# OpenAI-compatible LLM (leave blank to use deterministic mock diagnosis)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180

# Repository intelligence (Phase 3)
RETRIEVAL_ENABLED=true
WORKSPACE_DIR=.ash_agent/workspaces
GIT_CLONE_TIMEOUT_SECONDS=120
GITHUB_TOKEN=
# Needs repo scope to create branches and pull requests.
GITHUB_BASE_URL=https://github.com

NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=code_chunks

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=.ash_agent/models

RETRIEVAL_TOP_K=8
RETRIEVAL_CHUNK_LINES=60
RETRIEVAL_CHUNK_OVERLAP=10
RETRIEVAL_MAX_FILES=500

# Sandbox (Phase 4)
SANDBOX_ENABLED=true
SANDBOX_IMAGE=ash-agent-sandbox:py312
SANDBOX_NETWORK=none
SANDBOX_INSTALL_NETWORK=bridge
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_INSTALL_TIMEOUT_SECONDS=180
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_WORKSPACE_DIR=.ash_agent/sandboxes
SANDBOX_KEEP_WORKSPACE=false
SANDBOX_INSTALL_DEPENDENCIES=true
SANDBOX_TEST_ARGS=-q --disable-warnings --maxfail=5
DOCKER_BINARY=docker

# Patch generation and validation (Phase 5)
REPAIR_ENABLED=true
REPAIR_WORKSPACE_DIR=.ash_agent/repairs

# Pull requests and audit (Phase 6)
PUBLISH_ENABLED=true
GITHUB_API_URL=https://api.github.com
GITHUB_PR_BRANCH_PREFIX=ash-agent/fix

API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_USER=ash
POSTGRES_PASSWORD=ash
POSTGRES_DB=ash_agent
POSTGRES_PORT=5432

VALKEY_PORT=6379

NEO4J_USER=neo4j
NEO4J_PASSWORD=ashagent
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
